<?xml version="1.0" encoding="UTF-8"?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?><ScrollPane fitToWidth="true" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.supportsphere.controller.RegisterController"><content><VBox styleClass="page" spacing="18"><HBox alignment="CENTER_LEFT"><VBox HBox.hgrow="ALWAYS"><Label text="Create your SupportSphere account" styleClass="page-title"/><Label text="Choose how you want to use the platform. You can update your details later." styleClass="muted"/></VBox><Button text="Back to sign in" onAction="#back" styleClass="secondary-button"/></HBox><VBox styleClass="card" spacing="12"><Label text="Account" styleClass="section-title"/><GridPane hgap="12" vgap="10"><columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints><Label text="Full name" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/><Label text="Email" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="1"/><TextField fx:id="name" promptText="Your name" GridPane.rowIndex="1" GridPane.columnIndex="0"/><TextField fx:id="email" promptText="you@example.com" GridPane.rowIndex="1" GridPane.columnIndex="1"/><Label text="Password (6+ characters)" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/><Label text="Phone" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="1"/><PasswordField fx:id="password" GridPane.rowIndex="3" GridPane.columnIndex="0"/><TextField fx:id="phone" GridPane.rowIndex="3" GridPane.columnIndex="1"/><Label text="I want to…" styleClass="field-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/><ComboBox fx:id="role" GridPane.rowIndex="5" GridPane.columnIndex="0"/><Label text="Area" styleClass="field-label" GridPane.rowIndex="4" GridPane.columnIndex="1"/><TextField fx:id="area" promptText="e.g. Model Town" GridPane.rowIndex="5" GridPane.columnIndex="1"/><Label text="City" styleClass="field-label" GridPane.rowIndex="6" GridPane.columnIndex="0"/><TextField fx:id="city" promptText="e.g. Patiala" GridPane.rowIndex="7" GridPane.columnIndex="0"/><Label text="Landmark (optional)" styleClass="field-label" GridPane.rowIndex="6" GridPane.columnIndex="1"/><TextField fx:id="landmark" GridPane.rowIndex="7" GridPane.columnIndex="1"/></GridPane></VBox><VBox styleClass="card" fx:id="volunteerBox" spacing="12"><Label text="Volunteer profile" styleClass="section-title"/><Label text="Select the tasks you are comfortable helping with." styleClass="muted"/><FlowPane hgap="10" vgap="8"><CheckBox fx:id="grocery" text="Grocery Shopping"/><CheckBox fx:id="medicine" text="Medicine Collection"/><CheckBox fx:id="transport" text="Transportation"/><CheckBox fx:id="bill" text="Bill Payment"/><CheckBox fx:id="appointment" text="Appointment Assistance"/><CheckBox fx:id="document" text="Document Assistance"/><CheckBox fx:id="household" text="Household Assistance"/><CheckBox fx:id="other" text="Other"/></FlowPane><GridPane hgap="12" vgap="8"><Label text="Experience (years)" styleClass="field-label"/><Label text="Availability start" styleClass="field-label" GridPane.columnIndex="1"/><Label text="Availability end" styleClass="field-label" GridPane.columnIndex="2"/><TextField fx:id="experience" promptText="0" GridPane.rowIndex="1"/><TextField fx:id="startTime" text="09:00" GridPane.rowIndex="1" GridPane.columnIndex="1"/><TextField fx:id="endTime" text="18:00" GridPane.rowIndex="1" GridPane.columnIndex="2"/></GridPane></VBox><VBox styleClass="card" spacing="10"><Label text="Accessibility &amp; assistance notes" styleClass="section-title"/><TextArea fx:id="notes" promptText="Optional notes that help volunteers understand how best to assist you…" prefRowCount="4"/></VBox><Button text="Create SupportSphere account" onAction="#create" styleClass="primary-button" maxWidth="300"/></VBox></content></ScrollPane>