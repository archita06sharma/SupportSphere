<?xml version="1.0" encoding="UTF-8"?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?><BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.supportsphere.controller.RequesterDashboardController"><top><HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="18"><Label text="SupportSphere" styleClass="brand"/><Label text="Requester" styleClass="role-pill"/><Region HBox.hgrow="ALWAYS"/><Button text="🔔" onAction="#notifications" styleClass="icon-button"/><Label fx:id="notificationCount" text="0" styleClass="notification-count"/><Button text="Sign out" onAction="#logout" styleClass="ghost-button"/></HBox></top><center><VBox styleClass="page" spacing="18"><VBox><Label fx:id="welcome" text="Good day 👋" styleClass="page-title"/><Label text="Keep track of your assistance requests and the people helping you." styleClass="muted"/></VBox><HBox spacing="14"><VBox styleClass="stat-card" HBox.hgrow="ALWAYS"><Label text="Total requests" styleClass="stat-label"/><Label fx:id="total" text="0" styleClass="stat-number"/></VBox><VBox styleClass="stat-card" HBox.hgrow="ALWAYS"><Label text="Open" styleClass="stat-label"/><Label fx:id="open" text="0" styleClass="stat-number"/></VBox><VBox styleClass="stat-card" HBox.hgrow="ALWAYS"><Label text="Active" styleClass="stat-label"/><Label fx:id="active" text="0" styleClass="stat-number"/></VBox><VBox styleClass="stat-card" HBox.hgrow="ALWAYS"><Label text="Completed" styleClass="stat-label"/><Label fx:id="completed" text="0" styleClass="stat-number"/></VBox></HBox><HBox spacing="10"><Button text="＋ New assistance request" onAction="#create" styleClass="primary-button"/><Button text="View details" onAction="#details" styleClass="secondary-button"/><Button text="Cancel open request" onAction="#cancel" styleClass="secondary-button"/><Button text="Leave feedback" onAction="#feedback" styleClass="secondary-button"/></HBox><VBox styleClass="card" VBox.vgrow="ALWAYS"><Label text="My requests" styleClass="section-title"/><TableView fx:id="table" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="idCol" text="Request" prefWidth="90"/><TableColumn fx:id="taskCol" text="Task" prefWidth="190"/><TableColumn fx:id="urgencyCol" text="Priority" prefWidth="110"/><TableColumn fx:id="dateCol" text="Schedule" prefWidth="180"/><TableColumn fx:id="statusCol" text="Status" prefWidth="130"/><TableColumn fx:id="volCol" text="Volunteer" prefWidth="180"/></columns></TableView></VBox></VBox></center></BorderPane>