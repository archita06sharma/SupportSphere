<?xml version="1.0" encoding="UTF-8"?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?><ScrollPane fitToWidth="true" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.supportsphere.controller.CreateRequestController"><content><VBox styleClass="page" spacing="18"><HBox alignment="CENTER_LEFT"><VBox HBox.hgrow="ALWAYS"><Label text="New assistance request" styleClass="page-title"/><Label text="Tell us what you need, when you need it, and where assistance should happen." styleClass="muted"/></VBox><Button text="← Back" onAction="#back" styleClass="secondary-button"/></HBox><VBox styleClass="card" spacing="14"><Label text="What do you need help with?" styleClass="section-title"/><Label text="Task category" styleClass="field-label"/><ComboBox fx:id="task"/><Label text="Description" styleClass="field-label"/><TextArea fx:id="description" promptText="Describe the task and any important instructions…" prefRowCount="5"/><Label text="Urgency" styleClass="field-label"/><ComboBox fx:id="urgency"/></VBox><VBox styleClass="card" spacing="14"><Label text="Where?" styleClass="section-title"/><GridPane hgap="12" vgap="8"><Label text="Area" styleClass="field-label"/><Label text="City" styleClass="field-label" GridPane.columnIndex="1"/><TextField fx:id="area" GridPane.rowIndex="1"/><TextField fx:id="city" GridPane.rowIndex="1" GridPane.columnIndex="1"/><Label text="Landmark (optional)" styleClass="field-label" GridPane.rowIndex="2"/><TextField fx:id="landmark" GridPane.rowIndex="3"/></GridPane></VBox><VBox styleClass="card" spacing="14"><Label text="When?" styleClass="section-title"/><GridPane hgap="12" vgap="8"><Label text="Date" styleClass="field-label"/><Label text="Start time (HH:mm)" styleClass="field-label" GridPane.columnIndex="1"/><Label text="End time (HH:mm)" styleClass="field-label" GridPane.columnIndex="2"/><DatePicker fx:id="date" GridPane.rowIndex="1"/><TextField fx:id="start" text="10:00" GridPane.rowIndex="1" GridPane.columnIndex="1"/><TextField fx:id="end" text="11:00" GridPane.rowIndex="1" GridPane.columnIndex="2"/></GridPane></VBox><Button text="Create request" onAction="#save" styleClass="primary-button" maxWidth="260"/></VBox></content></ScrollPane>