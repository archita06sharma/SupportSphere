<?xml version="1.0" encoding="UTF-8"?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?><BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.supportsphere.controller.AdminDashboardController"><top><HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="18"><Label text="SupportSphere" styleClass="brand"/><Label text="Admin control center" styleClass="role-pill"/><Region HBox.hgrow="ALWAYS"/><Button text="Sign out" onAction="#logout" styleClass="ghost-button"/></HBox></top><center><VBox styleClass="page" spacing="18"><VBox><Label text="System overview" styleClass="page-title"/><Label text="Monitor users, requests, assignments and volunteer trust signals." styleClass="muted"/></VBox><HBox spacing="12"><VBox styleClass="stat-card" HBox.hgrow="ALWAYS"><Label text="Total users" styleClass="stat-label"/><Label fx:id="users" text="0" styleClass="stat-number"/></VBox><VBox styleClass="stat-card" HBox.hgrow="ALWAYS"><Label text="Active volunteers" styleClass="stat-label"/><Label fx:id="volunteers" text="0" styleClass="stat-number"/></VBox><VBox styleClass="stat-card" HBox.hgrow="ALWAYS"><Label text="Open requests" styleClass="stat-label"/><Label fx:id="open" text="0" styleClass="stat-number"/></VBox><VBox styleClass="stat-card" HBox.hgrow="ALWAYS"><Label text="Active assignments" styleClass="stat-label"/><Label fx:id="active" text="0" styleClass="stat-number"/></VBox><VBox styleClass="stat-card" HBox.hgrow="ALWAYS"><Label text="Completed" styleClass="stat-label"/><Label fx:id="completed" text="0" styleClass="stat-number"/></VBox></HBox><HBox spacing="10"><Button text="Verify selected volunteer" onAction="#verify" styleClass="primary-button"/><Button text="Block selected user" onAction="#block" styleClass="secondary-button"/><Button text="View assignments" onAction="#assignments" styleClass="secondary-button"/><Button text="View feedback" onAction="#feedback" styleClass="secondary-button"/></HBox><VBox styleClass="card" VBox.vgrow="ALWAYS"><Labe