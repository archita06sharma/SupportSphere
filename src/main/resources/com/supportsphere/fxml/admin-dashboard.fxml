<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.supportsphere.controller.AdminDashboardController">
    <top><HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="18"><Label text="SupportSphere" styleClass="brand"/><Label text="Admin control center" styleClass="role-pill"/><Region HBox.hgrow="ALWAYS"/><Button text="Refresh" onAction="#refresh" styleClass="secondary-button"/><Button text="Sign out" onAction="#logout" styleClass="ghost-button"/></HBox></top>
    <center><VBox styleClass="page" spacing="16">
        <VBox><Label text="System overview" styleClass="page-title"/><Label text="Manage users, volunteers, requests and trust signals." styleClass="muted"/></VBox>
        <HBox spacing="12"><VBox styleClass="stat-card" HBox.hgrow="ALWAYS"><Label text="Total users" styleClass="stat-label"/><Label fx:id="users" text="0" styleClass="stat-number"/></VBox><VBox styleClass="stat-card" HBox.hgrow="ALWAYS"><Label text="Active volunteers" styleClass="stat-label"/><Label fx:id="volunteers" text="0" styleClass="stat-number"/></VBox><VBox styleClass="stat-card" HBox.hgrow="ALWAYS"><Label text="Open requests" styleClass="stat-label"/><Label fx:id="open" text="0" styleClass="stat-number"/></VBox><VBox styleClass="stat-card" HBox.hgrow="ALWAYS"><Label text="Active assignments" styleClass="stat-label"/><Label fx:id="active" text="0" styleClass="stat-number"/></VBox><VBox styleClass="stat-card" HBox.hgrow="ALWAYS"><Label text="Completed" styleClass="stat-label"/><Label fx:id="completed" text="0" styleClass="stat-number"/></VBox></HBox>
        <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" styleClass="admin-tabs">
            <Tab text="Users"><VBox styleClass="card" spacing="10"><Label text="User accounts" styleClass="section-title"/><HBox spacing="10"><Button text="View profile" onAction="#viewUserProfile" fx:id="usersViewProfileButton" styleClass="secondary-button"/><Button text="Block selected" onAction="#block" fx:id="blockButton" styleClass="secondary-button"/><Button text="Unblock selected" onAction="#unblock" fx:id="unblockButton" styleClass="secondary-button"/></HBox><TableView fx:id="usersTable" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="userCol" text="Name" prefWidth="250"/><TableColumn fx:id="roleCol" text="Role" prefWidth="140"/><TableColumn fx:id="statusCol" text="Account status" prefWidth="160"/></columns></TableView></VBox></Tab>
            <Tab text="Volunteer Management"><VBox styleClass="card" spacing="10"><Label text="Volunteer profiles" styleClass="section-title"/><HBox spacing="10"><TextField fx:id="volunteerSearch" promptText="Search by ID, name or email" HBox.hgrow="ALWAYS"/><ComboBox fx:id="volunteerStatusFilter" prefWidth="140"/></HBox><HBox spacing="10"><Button fx:id="viewProfileButton" text="View profile" onAction="#viewProfile" styleClass="secondary-button"/><Button fx:id="verifyVolunteerButton" text="Verify" onAction="#verifyVolunteer" styleClass="primary-button"/><Button fx:id="rejectVolunteerButton" text="Reject" onAction="#rejectVolunteer" styleClass="secondary-button"/><Button fx:id="reopenVolunteerButton" text="Reopen" onAction="#reopenVolunteer" styleClass="secondary-button"/></HBox><Label fx:id="volunteerEmpty" text="No volunteers match the current filter." styleClass="muted" visible="false"/><TableView fx:id="volunteersTable" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="volunteerIdCol" text="ID" prefWidth="70"/><TableColumn fx:id="volunteerNameCol" text="Name" prefWidth="150"/><TableColumn fx:id="volunteerEmailCol" text="Email" prefWidth="210"/><TableColumn fx:id="volunteerStatusCol" text="Verification" prefWidth="120"/><TableColumn fx:id="volunteerRatingCol" text="Rating" prefWidth="100"/><TableColumn fx:id="volunteerExperienceCol" text="Experience" prefWidth="110"/><TableColumn fx:id="volunteerLocationCol" text="Location" prefWidth="160"/></columns></TableView></VBox></Tab>
            <Tab text="Requests"><VBox styleClass="card" spacing="8"><Label text="Assistance requests" styleClass="section-title"/><TableView fx:id="requestsTable" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="reqCol" text="Request · task · status · volunteer" prefWidth="900"/></columns></TableView></VBox></Tab>
            <Tab text="Assignments"><VBox styleClass="card" spacing="10"><HBox spacing="10"><Label text="Assignment monitoring" styleClass="section-title" HBox.hgrow="ALWAYS"/><ComboBox fx:id="assignmentFilter" prefWidth="150"/><Button text="View details" onAction="#viewAssignment" styleClass="secondary-button"/></HBox><TableView fx:id="assignmentsTable" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="assignmentCol" text="Assignment" prefWidth="100"/><TableColumn fx:id="assignmentRequestCol" text="Request" prefWidth="90"/><TableColumn fx:id="assignmentTaskCol" text="Task" prefWidth="150"/><TableColumn fx:id="assignmentRequesterCol" text="Requester" prefWidth="140"/><TableColumn fx:id="assignmentVolunteerCol" text="Volunteer" prefWidth="140"/><TableColumn fx:id="assignmentStatusCol" text="Status" prefWidth="120"/><TableColumn fx:id="assignmentDateCol" text="Assigned" prefWidth="170"/><TableColumn fx:id="assignmentCompletedCol" text="Completed" prefWidth="170"/></columns></TableView></VBox></Tab>
            <Tab text="Feedback"><VBox styleClass="card" spacing="10"><HBox spacing="10"><Label text="Requester feedback" styleClass="section-title" HBox.hgrow="ALWAYS"/><Button text="View details" onAction="#viewFeedback" styleClass="secondary-button"/></HBox><TableView fx:id="feedbackTable" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="feedbackCol" text="Feedback" prefWidth="90"/><TableColumn fx:id="feedbackRequestCol" text="Request" prefWidth="90"/><TableColumn fx:id="feedbackRequesterCol" text="Requester" prefWidth="150"/><TableColumn fx:id="feedbackVolunteerCol" text="Volunteer" prefWidth="150"/><TableColumn fx:id="feedbackRatingCol" text="Rating" prefWidth="90"/><TableColumn fx:id="feedbackCommentCol" text="Comment" prefWidth="350"/><TableColumn fx:id="feedbackDateCol" text="Submitted" prefWidth="170"/></columns></TableView></VBox></Tab>
            <Tab text="Audit Log"><VBox styleClass="card" spacing="10"><HBox spacing="10"><TextField fx:id="auditSearch" promptText="Search actor, action, user or details" HBox.hgrow="ALWAYS"/><ComboBox fx:id="auditActionFilter" prefWidth="220"/></HBox><TableView fx:id="auditTable" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="auditCol" text="Log ID" prefWidth="80"/><TableColumn fx:id="auditTimestampCol" text="Timestamp" prefWidth="170"/><TableColumn fx:id="auditActorCol" text="Actor" prefWidth="150"/><TableColumn fx:id="auditActionCol" text="Action" prefWidth="230"/><TableColumn fx:id="auditEntityCol" text="Entity" prefWidth="90"/><TableColumn fx:id="auditDetailsCol" text="Details" prefWidth="400"/></columns></TableView></VBox></Tab>
        </TabPane>
    </VBox></center>
</BorderPane>
